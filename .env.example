# ==============================================================================
# FlagRank Deployment Environment Configuration Template
# Copy this file to .env or set these environment variables in your deployment host.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# In production, set to your deployed backend URL (e.g. https://api.flagrank.example.com)
# or leave empty ('') if serving both frontend and backend behind a reverse proxy (e.g. Nginx).
VITE_API_BASE_URL=http://127.0.0.1:8000
